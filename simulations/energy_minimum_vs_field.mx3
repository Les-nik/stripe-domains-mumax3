// Equilibrium stripe period versus in-plane field.
// One stripe period of nx cells (2 nm each, nx = 50..80, i.e. 100-160 nm) with
// periodic boundaries; for every field B0 = 0..380 mT (step 5 mT) the stripe state
// is relaxed and the total energy density is written to table.txt.
// The period with the lowest energy is the equilibrium one (scripts/fig_stripe_period.py).

period := 138e-09 // 134.8 // 125 is good
// thickness := 63.8e-09

// like 4.2, but with different period + a12 = 0.71

nOfPeriods := 1


Ny := 10
Nz := 58 // 29

cz := 1.2e-09 // 2.2
cx := 2e-09
cy := 10e-09

Nx := ceil(period*nOfPeriods/cx)

thickness := Nz*cz

RepX := 2
RepY := 1024
RepZ := 0

setgridsize(Nx, Ny, Nz)
setcellsize(cx, cy, cz)
SetPBC(RepX, RepY, RepZ)  
EdgeSmooth=0

g := xrange(-inf, inf) 
setgeom(g)

for i:= 0; i<Nz; i++{
	reg := zrange(-Nz*cz/2+(i)*cz, -Nz*cz/2+(i+1)*cz) 
	print(i,  -Nz*cz/2+(i)*cz, -Nz*cz/2+(i+1)*cz)
	DefRegion(i+1, reg)
	}


eps:= 0.75
// eps:= 1.0
Ms := eps * 1650e3 // 1400
A  := eps * 35e-12
// Dind_1 := eps*1.417e-3
Dind_1 := 0
// Dind_2 := -eps*2.2e-3
Dind_2 := -eps*0e-3

Qf := 0.6
Ku := 0.5*mu0*Ms*Ms*(1+(Qf-1)/eps)
// Ku := 1/2*mu0*Ms*Ms*Q

h:=0.0
B0 := 0.0e-03
gammaLL = 190e09

// B_ext = vector(0, B0, 0)


alpha=0.01
for i:= 0; i<Nz; i++{
	Aex.SetRegion(i+1, A)
	Msat.SetRegion(i+1, Ms)
	Ku1.SetRegion(i+1, Ku)
	Dind.SetRegion(i+1, Dind_1)
	anisU.SetRegion(i+1, vector(0,0,1))
}

A12_block := 0.75 //0.65

for i:=0; i<=Nz; i++{
			ext_ScaleExchange(i, i+1, A12_block) 
}

Dind.SetRegion(1, Dind_2)
Dind.SetRegion(Nz, Dind_2)

Dind.SetRegion(2, Dind_2)
Dind.SetRegion(Nz-1, Dind_2)

// m = uniform(0, 1, 0.01)
maskM := newSlice(3, Nx, Ny, Nz)
for x:=0; x<Nx; x++{
    for y:=0; y<Ny; y++ {
        for z:=0; z<Nz; z++ {
                maskM.Set(0, x, y, z, 0)
                maskM.Set(1, x, y, z, 0.3)
                maskM.Set(2, x, y, z, cos(2*pi*(x*nOfPeriods)/(Nx)))



        }
    }
}
M.SetArray(maskM)
snapshot(m)



//

thermalNoise := newSlice(3, Nx, Ny, Nz)
for x:=0; x<Nx; x++{
    for y:=0; y<Ny; y++ {
        for z:=0; z<Nz; z++ {
                thermalNoise.set(0, x, y, z, 0.01*randNorm())
                thermalNoise.set(1, x, y, z, 0.01*randNorm())
                thermalNoise.set(2, x, y, z, 0.01*randNorm())
        }
    }
}
t1 := t
f1 := 35e09
t01 := 3/f1

B00 := 0
TableAddVar(B00, "B0", " ")
nxx := 0
TableAddVar(nxx, "nx", " ")
TableAdd(Edens_total)
n_per := 1


for B00=0; B00<=380; B00 += 5{
    for nxx=50; nxx<=80; nxx += 1{

        filenameformat = sprintf("%%s%%02d_B0_%d_Nx_%d", B00, nxx)

        print(nxx)
        setgridsize(nxx, Ny, Nz)
        setcellsize(cx, cy, cz)
        SetPBC(RepX, RepY, RepZ)  
        EdgeSmooth=0

        

        maskM := newSlice(3, nxx, Ny, Nz)
        for x:=0; x<nxx; x++{
            for y:=0; y<Ny; y++ {
                for z:=0; z<Nz; z++ {
                        maskM.Set(0, x, y, z, 0)
                        maskM.Set(1, x, y, z, 0.3)
                        maskM.Set(2, x, y, z, cos(2*pi*(x*n_per)/(nxx)))



                }
            }
        }
        M.SetArray(maskM)
        snapshot(m)
        relax()

        B_ext = vector(0, B00*1e-3, 0)
        relax()
        B_ext.add(thermalNoise, 0.001*sinc(2*pi*f1*(t-t01-t1)))
        run(2*t01)

        minimize()
        save(m)
        snapshot(m)
        
        TableSave()
    }
}



