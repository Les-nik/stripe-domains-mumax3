// Saturated state: in-plane field of 500 mT along y, spin waves along x
// (Damon-Eshbach geometry). Same material as stripes_k_perp.mx3.

period := 125e-09 // stała sieciowa
// thickness := 63.8e-09



Ny := 10
Nz := 58 // 29

cz := 1.2e-09 // 2.2
cx := 2e-09
cy := 50e-09 //10e-09

Nx := ceil(period*20/cx)

thickness := Nz*cz

RepX := 2
RepY := 2048 //1024
RepZ := 0

setgridsize(Nx, Ny, Nz)
setcellsize(cx, cy, cz)
SetPBC(RepX, RepY, RepZ)  
EdgeSmooth=0

g := xrange(-inf, inf) 
setgeom(g)

for i:= 0; i<Nz; i++{
	reg := zrange(-Nz*cz/2+(i)*cz, -Nz*cz/2+(i+1)*cz) 
	print(i,  -Nz*cz/2+(i)*cz, -Nz*cz/2+(i+1)*cz)
	DefRegion(i+1, reg)
	}


eps:= 0.75
// eps:= 1.0
Ms := eps * 1650e3
A  := eps * 35e-12
// Dind_1 := eps*1.417e-3
Dind_1 := 0
Dind_2 := -eps*0e-3

Qf := 0.6
Ku := 0.5*mu0*Ms*Ms*(1+(Qf-1)/eps)


h:=0.0
B0 := 500.0e-03
gammaLL = 190e09

alpha=0.01
for i:= 0; i<Nz; i++{
	Aex.SetRegion(i+1, A)
	Msat.SetRegion(i+1, Ms)
	Ku1.SetRegion(i+1, Ku)
	Dind.SetRegion(i+1, Dind_1)
	anisU.SetRegion(i+1, vector(0,0,1))
}

A12_block := 0.75 // 0.65

for i:=0; i<=Nz; i++{
			ext_ScaleExchange(i, i+1, A12_block) 
}

Dind.SetRegion(1, Dind_2)
Dind.SetRegion(Nz, Dind_2)

Dind.SetRegion(2, Dind_2)
Dind.SetRegion(Nz-1, Dind_2)

m = uniform(0, 1, 0.01)


B_ext = vector(0, B0, 0)
relax()

saveAs(m, "m_stab")

snapshot(m)


f_cut := 80e09
t_sampl := 0.5/(f_cut*1.1)
t0 := t + 10/f_cut

// MaxDt = 1/f_cut / 10	// T=8.333e-12
// MinDt = 1/f_cut / 200
// MaxErr = 0.05e-06


sz := 1.0
kcut:=300e6
mask:=newVectorMask(Nx,Ny,Nz)  //maska = funkcja w przestzreni
for i:=0; i<Nx; i++{
	r:=index2coord(i,0,0)  //polozenie komorki [m]
	x:=r.x()
	Bxyz:=sinc(kcut*x) 
	for j:=0; j<Ny; j++{
		for k:=0; k<Nz; k++{

			 r := index2coord(i,j,k)  //polozenie komorki [m]
        x := r.x()
        y := r.y()
        z := r.z()

        Bxyz = 0.5*sinc(kcut*x)

        // symmetric excitation
        for n := 1; n < 6; n++{
            Bxyz = Bxyz + sinc(kcut*x)*cos(  n*2*pi*(z-((Nz*cz-thickness)/2))/thickness    )
        } 

        // asymmetric excitation
        for n := 1; n < 6; n++{
            Bxyz = Bxyz + sinc(kcut*x)*sin(  n*2*pi*(z-((Nz*cz-thickness)/2))/thickness    )
        } 

        mask.setVector(i,j,k,vector(0, 0, Bxyz))
		}
	}
}
B_ext.add(mask, 0.001*sinc(2*pi*f_cut*(t-t0)))    //czesc przestrzenna razy czesc czasowa 

autosave(m, t_sampl)
run(400*t_sampl)
saveas(m, "m_final")

saveas(Msat, "M_sat")
saveas(regions, "regiony")